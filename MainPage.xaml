<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinToastRelay.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style TargetType="Expander">
            <Setter Property="MinHeight" Value="72" />
        </Style>
    </Page.Resources>
    <NavigationView
        x:Name="RootNavigationView"
        AlwaysShowHeader="False"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="False"
        OpenPaneLength="248"
        PaneDisplayMode="Left"
        PaneTitle="WinToastRelay"
        SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Tag="overview" Content="{x:Bind ViewModel.OverviewLabel, Mode=OneWay}">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="webhook" Content="{x:Bind ViewModel.WebhookLabel, Mode=OneWay}">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="filters" Content="{x:Bind ViewModel.FiltersLabel, Mode=OneWay}">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE71C;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Tag="activity" Content="{x:Bind ViewModel.ActivityLabel, Mode=OneWay}">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Tag="settings" Content="{x:Bind ViewModel.SettingsLabel, Mode=OneWay}">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.Content>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Padding="32,0">
                    <Grid x:Name="ContentRoot" MaxWidth="1040" HorizontalAlignment="Stretch" Padding="0,40,0,56">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ContentTranslateTransform" />
                        </Grid.RenderTransform>

                        <StackPanel Visibility="{x:Bind ViewModel.OverviewVisibility, Mode=OneWay}" Spacing="24">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Text="{x:Bind ViewModel.OverviewTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.AppSubtitle, Mode=OneWay}" FontSize="18" Opacity="0.78" /><TextBlock Text="{x:Bind ViewModel.OverviewDescription, Mode=OneWay}" Visibility="Collapsed" /></StackPanel><BitmapIcon Grid.Column="1" UriSource="ms-appx:///Assets/WinToastRelayIcons/windows/Square150x150Logo.scale-200.png" ShowAsMonochrome="False" Width="64" Height="64" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                            <TextBlock Text="{x:Bind ViewModel.StatsTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16"><StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.StatsDeliveriesValue, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.StatsDeliveriesLabel, Mode=OneWay}" Opacity="0.68"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16"><StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.StatsApplicationsValue, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.StatsApplicationsLabel, Mode=OneWay}" Opacity="0.68"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16"><StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.StatsSuccessValue, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.StatsSuccessLabel, Mode=OneWay}" Opacity="0.68"/></StackPanel></Border>
                            </Grid>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="24">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel Spacing="7">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Ellipse Width="10" Height="10" Fill="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.RunningLabel, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}" Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel><ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" MaxWidth="48" IsOn="{x:Bind ViewModel.IsRelayRunning, Mode=OneWay}" OnContent="" OffContent="" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Margin="0" Toggled="RelayToggle_Toggled" VerticalAlignment="Center" /></Grid>
                            </Border>
                            <Border Visibility="{x:Bind ViewModel.SetupCardVisibility, Mode=OneWay}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="24">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.SetupCardTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SetupCardDescription, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
                                    <Button Click="ConfigureDestination_Click" Content="{x:Bind ViewModel.ConfigureDestinationLabel, Mode=OneWay}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18"><StackPanel Spacing="4"><TextBlock Text="{x:Bind ViewModel.PermissionInfoTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.PermissionHint, Mode=OneWay}" Opacity="0.68" TextWrapping="Wrap"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.WebhookVisibility, Mode=OneWay}" Spacing="24">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.WebhookLabel, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SetupCardDescription, Mode=OneWay}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,12"><StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.DeliveryModeLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/><ComboBox SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.DeliveryMode, Mode=TwoWay}">
                                        <ComboBoxItem Tag="bark" Content="{x:Bind ViewModel.BarkModeLabel, Mode=OneWay}" />
                                        <ComboBoxItem Tag="wxpusher" Content="{x:Bind ViewModel.WxPusherModeLabel, Mode=OneWay}" />
                                        <ComboBoxItem Tag="json" Content="{x:Bind ViewModel.JsonWebhookModeLabel, Mode=OneWay}" />
                                    </ComboBox><TextBlock Text="{x:Bind ViewModel.SetupCardDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Border>
                                    <StackPanel Visibility="{x:Bind ViewModel.BarkVisibility, Mode=OneWay}" Spacing="8">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18"><TextBlock Text="{x:Bind ViewModel.BarkRouteDescription, Mode=OneWay}" Opacity="0.72" TextWrapping="Wrap"/></Border>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.BarkServerUrlLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.BarkServerUrl, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBox Text="{x:Bind ViewModel.BarkServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{x:Bind ViewModel.BarkServerUrlDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.BarkDeviceKeyLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.BarkDeviceKey, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><TextBox PlaceholderText="your-bark-device-key" Text="{x:Bind ViewModel.BarkDeviceKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.BarkTemplateTitleLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.BarkTitleTemplate, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><TextBox Text="{x:Bind ViewModel.BarkTitleTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.BarkTemplateBodyLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.BarkBodyTemplate, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBox Text="{x:Bind ViewModel.BarkBodyTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="{x:Bind ViewModel.BarkTemplateDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                        <Expander MinHeight="96" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="6" Margin="0,10"><TextBlock Text="{x:Bind ViewModel.BarkParametersLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.BarkParameters, Mode=OneWay}" Opacity="0.62" FontSize="13" TextWrapping="Wrap"/></StackPanel></Expander.Header><StackPanel Spacing="10"><TextBox x:Name="BarkParametersTextBox" AcceptsReturn="True" Height="96" MinHeight="72" MaxHeight="336" Padding="10,8" PlaceholderText="sound=bell&#x0a;group=work&#x0a;level=timeSensitive" Text="{x:Bind ViewModel.BarkParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Loaded="BarkParametersTextBox_Loaded" TextChanged="BarkParametersTextBox_TextChanged" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.BarkParametersDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                    </StackPanel>
                                    <StackPanel Visibility="{x:Bind ViewModel.WxPusherVisibility, Mode=OneWay}" Spacing="8">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18"><TextBlock Text="{x:Bind ViewModel.WxPusherRouteDescription, Mode=OneWay}" Opacity="0.72" TextWrapping="Wrap"/></Border>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WxPusherAppTokenLabel, Mode=OneWay}"/><TextBlock Text="••••••••" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><StackPanel Spacing="8"><PasswordBox x:Name="WxPusherAppTokenBox" PasswordChanged="WxPusherAppTokenBox_PasswordChanged"/><TextBlock Text="{x:Bind ViewModel.WxPusherAppTokenDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WxPusherUidsLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.WxPusherUids, Mode=OneWay}" Opacity="0.62" FontSize="13" TextWrapping="Wrap"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBox AcceptsReturn="True" MinHeight="72" MaxHeight="240" PlaceholderText="UID_xxx&#x0a;UID_yyy" Text="{x:Bind ViewModel.WxPusherUids, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.WxPusherUidsDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WxPusherTopicIdsLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.WxPusherTopicIds, Mode=OneWay}" Opacity="0.62" FontSize="13" TextWrapping="Wrap"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBox AcceptsReturn="True" MinHeight="72" MaxHeight="192" PlaceholderText="123&#x0a;456" Text="{x:Bind ViewModel.WxPusherTopicIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.WxPusherTopicIdsDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WxPusherSummaryTemplateLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.WxPusherSummaryTemplate, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><TextBox Text="{x:Bind ViewModel.WxPusherSummaryTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Expander>
                                        <Expander Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WxPusherContentTemplateLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.WxPusherContentTemplate, Mode=OneWay}" Opacity="0.62" FontSize="13" TextWrapping="Wrap"/></StackPanel></Expander.Header><StackPanel Spacing="8"><TextBox AcceptsReturn="True" MinHeight="72" MaxHeight="240" Text="{x:Bind ViewModel.WxPusherContentTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.WxPusherTemplateDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                    </StackPanel>
                                    <StackPanel Visibility="{x:Bind ViewModel.JsonWebhookVisibility, Mode=OneWay}" Spacing="8">
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.WebhookUrlLabel, Mode=OneWay}"/><TextBlock Text="{x:Bind ViewModel.WebhookUrl, Mode=OneWay}" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><TextBox PlaceholderText="{x:Bind ViewModel.WebhookUrlPlaceholder, Mode=OneWay}" Text="{x:Bind ViewModel.WebhookUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></Expander>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4"><Expander.Header><StackPanel Spacing="5" Margin="0,4"><TextBlock Text="{x:Bind ViewModel.BearerTokenLabel, Mode=OneWay}"/><TextBlock Text="••••••••" Opacity="0.62" FontSize="13"/></StackPanel></Expander.Header><StackPanel Spacing="8"><PasswordBox x:Name="BearerTokenBox" PasswordChanged="BearerTokenBox_PasswordChanged"/><TextBlock Text="{x:Bind ViewModel.BearerTokenDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap"/></StackPanel></Expander>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Content="{x:Bind ViewModel.SaveLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SaveSettingsCommand}" Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Button Content="{x:Bind ViewModel.TestLabel, Mode=OneWay}" Command="{x:Bind ViewModel.TestWebhookCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.FiltersVisibility, Mode=OneWay}" Spacing="24">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.FiltersTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.FiltersDescription, Mode=OneWay}" Opacity="0.68" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Visibility="{x:Bind ViewModel.EmptyApplicationsVisibility, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,72,0,32" Spacing="10">
                                <FontIcon Glyph="&#xE71C;" FontSize="36" HorizontalAlignment="Center" Opacity="0.55" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyApplicationsLabel, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyApplicationsDescription, Mode=OneWay}" HorizontalAlignment="Center" MaxWidth="440" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListView x:Name="ApplicationsList" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.ApplicationsVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Applications, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Margin="0,0,0,6" Padding="14,10">
                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                                <Grid Width="96" Height="96" VerticalAlignment="Center">
                                                    <Border Visibility="{Binding FallbackVisibility}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" />
                                                    <FontIcon Visibility="{Binding FallbackVisibility}" Glyph="&#xE77B;" FontSize="28" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding IconSource}" Width="92" Height="92" Stretch="UniformToFill" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                <ToggleSwitch Grid.Column="2" Width="48" MinWidth="0" MaxWidth="48" IsOn="{Binding IsEnabled, Mode=TwoWay}" OffContent="" OnContent="" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Margin="0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="{x:Bind ViewModel.RefreshApplicationsLabel, Mode=OneWay}" Command="{x:Bind ViewModel.RefreshApplicationsCommand}" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.ActivityVisibility, Mode=OneWay}" Spacing="28">
                            <TextBlock Text="{x:Bind ViewModel.ActivityTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            <StackPanel Visibility="{x:Bind ViewModel.ActivityEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" Margin="0,96,0,48" Spacing="10">
                                <FontIcon Glyph="&#xE9D9;" FontSize="36" HorizontalAlignment="Center" Opacity="0.55" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyActivityLabel, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyActivityDescription, Mode=OneWay}" HorizontalAlignment="Center" MaxWidth="420" Opacity="0.62" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <ListView Padding="0" HorizontalContentAlignment="Stretch" Visibility="{x:Bind ViewModel.ActivityListVisibility, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Margin="0,0,0,12">
                                            <Expander.Header><Grid Margin="18,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="7"><TextBlock Text="{Binding App}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{Binding Summary}" Opacity="0.82" TextWrapping="Wrap"/><TextBlock Text="{Binding Body}" FontSize="15" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="12" Opacity="0.55" VerticalAlignment="Center"/></Grid></Expander.Header>
                                            <Border Padding="18,0,18,20"><StackPanel Spacing="10"><TextBlock Text="{Binding Detail}" Opacity="0.64" TextWrapping="Wrap"/></StackPanel></Border>
                                        </Expander>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Visibility="{x:Bind ViewModel.SettingsVisibility, Mode=OneWay}" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.SettingsTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind ViewModel.LanguageLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.LanguageDescription, Mode=OneWay}" Opacity="0.62"/></StackPanel><ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" SelectedValuePath="Tag" SelectionChanged="LanguageCombo_SelectionChanged"><ComboBoxItem Content="{x:Bind ViewModel.ChineseLanguageOption, Mode=OneWay}" Tag="zh-CN"/><ComboBoxItem Content="{x:Bind ViewModel.EnglishLanguageOption, Mode=OneWay}" Tag="en-US"/></ComboBox></Grid>
                            </Border>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Text="{x:Bind ViewModel.StartWithWindowsLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBlock Text="{x:Bind ViewModel.StartWithWindowsDescription, Mode=OneWay}" Opacity="0.62" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" Width="48" MinWidth="0" MaxWidth="48" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=OneWay}" OnContent="" OffContent="" HorizontalAlignment="Right" HorizontalContentAlignment="Right" Margin="0" Toggled="StartupToggle_Toggled" /></Grid>
                            </Border>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="18,16">
                                <StackPanel Spacing="8"><TextBlock Text="{x:Bind ViewModel.AboutTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind ViewModel.AboutDescription, Mode=OneWay}" Opacity="0.68" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.MadeByLabel, Mode=OneWay}" Opacity="0.68"/><HyperlinkButton Content="{x:Bind ViewModel.GithubLabel, Mode=OneWay}" NavigateUri="{x:Bind ViewModel.GithubUrl, Mode=OneWay}" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind ViewModel.VersionLabel, Mode=OneWay}" FontSize="12" Opacity="0.5"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </NavigationView.Content>
    </NavigationView>
</Page>
